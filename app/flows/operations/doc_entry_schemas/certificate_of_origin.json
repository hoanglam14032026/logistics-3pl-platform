    {
      "key": "importer_name",
      "label": "Nhà nhập khẩu",
      "type": "string",
      "max_length": 300
    },
    {
      "key": "origin_country",
      "label": "Nước xuất xứ",
      "type": "string",
      "required": true,
      "max_length": 100
