{
  "code": "commercial_invoice",
  "version": 1,
  "name": "Hóa đơn thương mại (Commercial Invoice)",
  "description": "Nhập tay hóa đơn thương mại đính kèm lô.",
  "target": null,
  "fields": [
    {
      "key": "invoice_no",
      "label": "Số hóa đơn",
      "type": "string",
      "required": true,
      "max_length": 100
    },
    {
      "key": "invoice_date",
      "label": "Ngày hóa đơn",
      "type": "date",
      "required": true
    },
    {
      "key": "seller_name",
      "label": "Người bán",
      "type": "string",
      "required": true,
      "max_length": 300
    },
    {
      "key": "buyer_name",
      "label": "Người mua",
      "type": "string",
      "required": true,
      "max_length": 300
    },
    {
      "key": "incoterm",
      "label": "Incoterms 2020",
      "type": "enum",
      "values": [
        "EXW",
        "FCA",
        "CPT",
        "CIP",
        "DAP",
        "DPU",
        "DDP",
        "FAS",
        "FOB",
        "CFR",
        "CIF"
      ]
    },
    {
      "key": "currency",
      "label": "Tiền tệ (ISO 4217)",
      "type": "string",
      "required": true,
      "max_length": 3
    },
    {
      "key": "total_amount",
      "label": "Tổng tiền",
      "type": "number",
      "required": true
    },
    {
      "key": "payment_terms",
      "label": "Điều kiện thanh toán",
      "type": "string",
      "max_length": 300
    },
    {
      "key": "goods",
      "label": "Dòng hàng",
      "type": "array",
      "items": [
        {
          "key": "description",
          "label": "Mô tả hàng",
          "type": "string",
          "required": true,
          "max_length": 1000
        },
        {
          "key": "hs_code",
          "label": "Mã HS",
          "type": "string",
          "max_length": 12
        },
        {
          "key": "quantity",
          "label": "Số lượng",
          "type": "number"
        },
        {
          "key": "unit",
          "label": "Đơn vị",
          "type": "string",
          "max_length": 20
        },
        {
          "key": "unit_price",
          "label": "Đơn giá",
          "type": "number"
        },
        {
          "key": "amount",
          "label": "Thành tiền",
          "type": "number"
        }
      ]
    }
  ]
}