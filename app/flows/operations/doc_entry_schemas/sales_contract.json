      "label": "Bên mua",
      "type": "string",
      "required": true,
      "max_length": 300
    },
    {
      "key": "incoterm",
      "label": "Incoterms 2020",
      "type": "enum",
      "values": [
        "EXW",
        "FCA",
        "CPT",
        "CIP",
        "DAP",
        "DPU",
        "DDP",
        "FAS",
        "FOB",
        "CFR",
        "CIF"
      ]
    },
    {
      "key": "currency",
      "label": "Tiền tệ",
      "type": "string",
      "max_length": 3
    },
    {
      "key": "total_value",
      "label": "Tổng giá trị",
      "type": "number"
    },
    {
      "key": "payment_terms",
      "label": "Điều kiện thanh toán",
      "type": "text",
      "max_length": 2000
