{
  "code": "commercial_invoice",
  "version": 2,
  "name": "Hóa đơn thương mại (Commercial Invoice)",
  "description": "Tự điền form tạo hóa đơn (ops_commercial_invoices). Lô hàng / hợp đồng gắn với hóa đơn: người duyệt chọn trên form. Giá trị lớn (≥ DOCAI_DUAL_APPROVAL_THRESHOLDS) cần 2 người duyệt.",
  "instructions": "Số tiền ghi dạng số thuần (vd. 12500.50), không ký hiệu tiền tệ. currency là mã ISO 4217 (USD, VND, EUR…). Ngày dạng YYYY-MM-DD. incoterm là mã Incoterms 2020.",
  "target": "commercial_invoice",
  "dual_approval": {"mode": "amount", "amount_field": "total_amount", "currency_field": "currency"},
  "fields": [
    {"key": "invoice_no", "label": "Số hóa đơn", "type": "string", "required": true, "max_length": 100, "form_field": "invoice_no"},
    {"key": "invoice_date", "label": "Ngày hóa đơn", "type": "date", "required": true, "form_field": "invoice_date"},
    {"key": "seller_name", "label": "Người bán", "type": "string", "required": true, "max_length": 300, "form_field": "seller_name"},
    {"key": "buyer_name", "label": "Người mua", "type": "string", "required": true, "max_length": 300, "form_field": "buyer_name"},
    {"key": "incoterm", "label": "Incoterms 2020", "type": "enum",
     "values": ["EXW", "FCA", "CPT", "CIP", "DAP", "DPU", "DDP", "FAS", "FOB", "CFR", "CIF"], "form_field": "incoterm"},
    {"key": "currency", "label": "Tiền tệ", "type": "string", "required": true, "max_length": 3, "form_field": "currency"},
    {"key": "total_amount", "label": "Tổng tiền", "type": "number", "required": true, "form_field": "total_amount"},
    {"key": "items", "label": "Dòng hàng", "type": "array", "form_field": "items",
     "items": [
       {"key": "description", "label": "Mô tả", "type": "string", "required": true, "max_length": 1000},
       {"key": "hs_code", "label": "Mã HS", "type": "string", "max_length": 12},
       {"key": "quantity", "label": "Số lượng", "type": "number"},
       {"key": "unit", "label": "Đơn vị", "type": "string", "max_length": 20},
       {"key": "unit_price", "label": "Đơn giá", "type": "number"},
       {"key": "amount", "label": "Thành tiền", "type": "number"}
     ]}
  ]
}
