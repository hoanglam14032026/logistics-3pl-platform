# Mẫu file .env (đặc tả 06 §6). Sao chép thành .env rồi điền giá trị; .env không đưa vào git, Docker image.
# Đủ danh sách biến và mặc định: docs/specs/06-quy-uoc-api-bao-mat.md §6, app/core/config.py.

# Bắt buộc. Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"  (tối thiểu 32 ký tự)
JWT_SECRET=

# Bắt buộc (Giai đoạn 6). Khóa Fernet mã hóa totp_secret trong CSDL – khác JWT_SECRET, giữ bí mật và sao lưu riêng:
# mất khóa thì mọi người dùng phải thiết lập lại 2FA. Sinh khóa: python -m app.core.secretbox
# Xoay khóa: TOTP_ENCRYPTION_KEY=<khóa mới>,<khóa cũ>
TOTP_ENCRYPTION_KEY=

# docker-compose – mật khẩu "logistics" chỉ dùng cho máy dev, không dùng cho môi trường thật
# POSTGRES_PASSWORD=logistics
# POSTGRES_PORT=5432

# DATABASE_URL=postgresql+psycopg://logistics:logistics@localhost:5432/logistics_3pl_dev
# TEST_DATABASE_URL=postgresql+psycopg://logistics:logistics@localhost:5432/logistics_3pl_test
# UPLOAD_DIR=./data/uploads
# ENABLED_FLOWS=ops,control,learning,assessment
# JWT_ACCESS_TTL_MIN=15
# JWT_REFRESH_TTL_DAYS=7
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOCKOUT_MINUTES=15
# AUTH_LOGIN_RATE_LIMIT_PER_IP=20
# AUTH_LOGIN_RATE_LIMIT_PER_USERNAME=10
# AUTH_LOGIN_RATE_WINDOW_SEC=60
# AUTH_2FA_REQUIRED_ROLES=customer
# AUTH_MFA_TOKEN_TTL_SEC=300
# TOTP_ISSUER="Logistics 3PL"
# INVITE_TOKEN_TTL_HOURS=72
# PASSWORD_RESET_TOKEN_TTL_MIN=30
# PUBLIC_BASE_URL=https://portal.example.vn
# CORS_ORIGINS=http://localhost:5173,https://portal.example.vn

# Thư điện tử (thư mời, đặt lại mật khẩu – gửi nền sau khi trả response) – để trống thì MAIL_BACKEND=auto ghi thư ra log
# SMTP_HOST=smtp.example.vn
# SMTP_PORT=587
# SMTP_USERNAME=no-reply@example.vn
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# SMTP_TIMEOUT_SEC=10
# MAIL_BACKEND=auto
# SMTP_FROM="Logistics 3PL <no-reply@example.vn>"
