# Mẫu file .env (đặc tả 06 §6). Sao chép thành .env rồi điền giá trị; .env không đưa vào git, Docker image.
# Đủ danh sách biến và mặc định: docs/specs/06-quy-uoc-api-bao-mat.md §6, app/core/config.py.

# Bắt buộc. Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"  (tối thiểu 32 ký tự)
JWT_SECRET=

# Bắt buộc (Giai đoạn 6). Khóa Fernet mã hóa totp_secret trong CSDL – khác JWT_SECRET, giữ bí mật và sao lưu riêng:
# mất khóa thì mọi người dùng phải thiết lập lại 2FA. Sinh khóa: python -m app.core.secretbox
# Xoay khóa: TOTP_ENCRYPTION_KEY=<khóa mới>,<khóa cũ>
TOTP_ENCRYPTION_KEY=

# docker-compose – mật khẩu "logistics" chỉ dùng cho máy dev, không dùng cho môi trường thật
# POSTGRES_PASSWORD=logistics
# POSTGRES_PORT=5432

# DATABASE_URL=postgresql+psycopg://logistics:logistics@localhost:5432/logistics_3pl_dev
# TEST_DATABASE_URL=postgresql+psycopg://logistics:logistics@localhost:5432/logistics_3pl_test
# UPLOAD_DIR=./data/uploads
# ENABLED_FLOWS=ops,control,learning,assessment
# JWT_ACCESS_TTL_MIN=15
# JWT_REFRESH_TTL_DAYS=7
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOCKOUT_MINUTES=15
# AUTH_LOGIN_RATE_LIMIT_PER_IP=20
# AUTH_LOGIN_RATE_LIMIT_PER_USERNAME=10
# AUTH_LOGIN_RATE_WINDOW_SEC=60
# AUTH_2FA_REQUIRED_ROLES=customer
# AUTH_MFA_TOKEN_TTL_SEC=300
# TOTP_ISSUER="Logistics 3PL"
# INVITE_TOKEN_TTL_HOURS=72
# PASSWORD_RESET_TOKEN_TTL_MIN=30
# PUBLIC_BASE_URL=https://portal.example.vn
# CORS_ORIGINS=http://localhost:5173,https://portal.example.vn

# Hàng đợi tác vụ nền bền vững (Giai đoạn 7) – Redis của docker-compose. Để trống: chạy nền trong tiến trình API
# (mất khi tiến trình dừng, không thử lại – chỉ máy dev). Worker: python -m app.worker
# JOB_QUEUE_URL=redis://localhost:6379/0
# TEST_JOB_QUEUE_URL=redis://localhost:6379/15
# JOB_MAX_RETRIES=5
# JOB_RETRY_INTERVALS=10,30,120,600,1800
# JOB_TIMEOUT_SEC=60
# JOB_FAILURE_TTL_DAYS=30
# REDIS_PORT=6379

# Giới hạn tần suất mọi API / tải file (Giai đoạn 7), mỗi RATE_LIMIT_WINDOW_SEC giây
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_SEC=60
# RATE_LIMIT_API_PER_USER=300
# RATE_LIMIT_API_PER_IP=120
# RATE_LIMIT_FILE_UPLOAD_PER_USER=20
# RATE_LIMIT_FILE_DOWNLOAD_PER_USER=120

# Thư điện tử (thư mời, đặt lại mật khẩu – gửi nền sau khi trả response) – để trống thì MAIL_BACKEND=auto ghi thư ra log
# SMTP_HOST=smtp.example.vn
# SMTP_PORT=587
# SMTP_USERNAME=no-reply@example.vn
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
# SMTP_TIMEOUT_SEC=10
# MAIL_BACKEND=auto
# SMTP_FROM="Logistics 3PL <no-reply@example.vn>"

# AI local trích xuất chứng từ (Giai đoạn 9) – KHÔNG gọi API cloud nào. Chỉ máy chủ model trong máy / mạng nội bộ:
# localhost, IP mạng riêng (10.x, 172.16–31.x, 192.168.x, fc00::/7), tên một nhãn (vd. ollama), hậu tố .local, .lan,
# .internal, .home.arpa. Địa chỉ khác (kể cả 169.254.x – metadata đám mây) → ứng dụng KHÔNG khởi động.
# Danh mục model đọc từ bảng ai_models (admin thêm qua /api/v2/admin/ai-models) – không ghi tên model ở đây.
# OLLAMA_URL=http://localhost:11434
# docker-compose: api, worker gọi Ollama trên máy chủ qua địa chỉ này
# OLLAMA_URL_DOCKER=http://host.docker.internal:11434
# Tên máy chủ nội bộ thêm (lúc gọi vẫn kiểm DNS phải ra địa chỉ mạng riêng)
# AI_ALLOWED_HOSTS=ai.noibo.congty.vn
# Mã (code) model được ĐÁNH DẤU gợi ý trong danh sách chọn – chỉ là gợi ý, người dùng vẫn phải chọn và gửi model_id
# AI_MODEL_DEFAULT=qwen3.8-27b
# OCR: tesseract (cài tesseract-ocr + tesseract-ocr-vie) hoặc paddle (pip install -r requirements-ocr-paddle-lock.txt,
# model tải sẵn trong DOCAI_PADDLE_MODEL_DIR/det, /rec – không tải từ Internet)
# DOCAI_OCR_ENGINE=tesseract
# DOCAI_TESSERACT_CMD=tesseract
# DOCAI_OCR_LANGS=vie+eng
# DOCAI_PADDLE_MODEL_DIR=
# DOCAI_OCR_TIMEOUT_SEC=120
# Dưới ngưỡng (hoặc thiếu trường bắt buộc) → needs_review; đủ ngưỡng vẫn phải duyệt
# DOCAI_MIN_CONFIDENCE=0.9
# DOCAI_MAX_PAGES=30
# DOCAI_PDF_DPI=200
# DOCAI_MAX_TEXT_CHARS=60000
# DOCAI_VISION_MAX_PAGES=4
# DOCAI_LLM_TIMEOUT_SEC=600
# DOCAI_JOB_TIMEOUT_SEC=1800
# Duyệt 2 người (Giai đoạn 10): hóa đơn có tổng tiền ≥ ngưỡng của đồng tiền cần 2 người duyệt (hợp đồng: luôn 2 người)
# DOCAI_DUAL_APPROVAL_THRESHOLDS=VND:500000000,USD:20000,EUR:20000

# Outbox sự kiện (Giai đoạn 10): worker gửi sự kiện vào Redis Stream <prefix>control (Luồng 2), <prefix>assessment (Luồng 4)
# EVENT_STREAM_PREFIX=l3pl:events:
# EVENT_STREAM_MAXLEN=100000

# Luồng 2 – theo dõi thực thi (Giai đoạn 12): chu kỳ quét chậm trễ (0 = tắt), bước trễ từ N giờ → cảnh báo critical
# CONTROL_SCAN_INTERVAL_SEC=300
# CONTROL_OVERDUE_CRITICAL_HOURS=24
